#!/bin/bash
# PBS job script for one (ARCH, SEED) training run.
# Called by submit_all.sh via: qsub -v ARCH=ippo,SEED=8001 hpc/job.pbs
#
# Resource request: 1 GPU node, 8 CPUs, 96h walltime.
# Training is CPU-bottlenecked (NumPy environment simulation); the GPU node
# is used only because it has more available CPUs for the process.
# 20k episodes at ~9s/ep ≈ 50h; 96h gives a safe buffer.
#PBS -q gpu
#PBS -l select=1:ncpus=8
#PBS -l walltime=96:00:00

# Output/error logs are set dynamically by submit_all.sh via -o/-e flags.

# --- Environment ---
source /apps/miniconda3/etc/profile.d/conda.sh
conda activate marl

# --- Working directory ---
cd "$HOME/sps/stochastic-particle-system"

# --- Validate required vars ---
: "${ARCH:?Variable ARCH not set}"
: "${SEED:?Variable SEED not set}"

N_EPISODES="${N_EPISODES:-20000}"
N_STEPS="${N_STEPS:-500000}"
COMMIT=$(git rev-parse HEAD 2>/dev/null || echo "unknown")

OUTPUT="results/raw/SPS-WO-08-MARL/${ARCH}_seed${SEED}.json"
CKPT_DIR="results/raw/SPS-WO-08-MARL/checkpoints/${ARCH}_seed${SEED}"

# Auto-detect latest checkpoint so re-submitted jobs resume rather than restart.
RESUME_ARG=""
if [[ -d "$CKPT_DIR" ]]; then
    LATEST_CKPT=$(ls -t "$CKPT_DIR"/checkpoint_*.pt 2>/dev/null | head -1)
    if [[ -n "$LATEST_CKPT" ]]; then
        RESUME_ARG="--resume-from $LATEST_CKPT"
        echo "  resuming from: $LATEST_CKPT"
    fi
fi

echo "=== SPS-WO-08 MARL training ==="
echo "  arch=${ARCH}  seed=${SEED}  n_episodes=${N_EPISODES}"
echo "  commit=${COMMIT}"
echo "  output=${OUTPUT}"
echo "  started: $(date)"
echo ""

python analysis/train_single_marl.py \
    --arch "$ARCH" \
    --train-seed "$SEED" \
    --n-episodes "$N_EPISODES" \
    --n-steps "$N_STEPS" \
    --output "$OUTPUT" \
    --checkpoint-dir "$CKPT_DIR" \
    $RESUME_ARG \
    --repository-base-commit "$COMMIT"

echo ""
echo "  finished: $(date)"
