{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PuffBear/stochastic-particle-system/schemas/aggregation_run_manifest.schema.json",
  "title": "SPS-C04 aggregation-pair run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "experiment_id", "created_at_utc", "repository", "environment", "pairing", "intervention", "runtime", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["full_name", "branch", "commit_sha", "dirty"],
      "properties": {"full_name": {"const": "PuffBear/stochastic-particle-system"}, "branch": {"type": "string", "minLength": 1}, "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "dirty": {"type": "boolean"}}
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["config_path", "config_sha256"],
      "properties": {"config_path": {"type": "string", "minLength": 1}, "config_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "pairing": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_seed", "arms", "pre_generated_noise", "shared_initial_state", "same_nonzero_field", "initial_state_sha256", "brownian_tensor_sha256", "field_realization_sha256", "policy_randomness_sha256", "tie_key_provenance_sha256"],
      "properties": {
        "scenario_seed": {"type": "integer", "minimum": 0},
        "arms": {"type": "array", "prefixItems": [{"const": "self_only"}, {"const": "all_to_all"}], "items": false},
        "pre_generated_noise": {"const": true},
        "shared_initial_state": {"const": true},
        "same_nonzero_field": {"const": true},
        "initial_state_sha256": {"$ref": "#/$defs/sha256"},
        "brownian_tensor_sha256": {"$ref": "#/$defs/sha256"},
        "field_realization_sha256": {"$ref": "#/$defs/sha256"},
        "policy_randomness_sha256": {"$ref": "#/$defs/sha256"},
        "tie_key_provenance_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "intervention": {
      "type": "object", "additionalProperties": false,
      "required": ["self_only_mode", "all_to_all_mode", "same_encoder", "same_decoder", "same_message_dimension", "teammates_disabled"],
      "properties": {
        "self_only_mode": {"enum": ["independent", "all_to_all"]},
        "all_to_all_mode": {"enum": ["independent", "all_to_all"]},
        "same_encoder": {"const": true}, "same_decoder": {"const": true},
        "same_message_dimension": {"const": 3}, "teammates_disabled": {"const": true}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["python", "numpy", "platform", "command"],
      "properties": {"python": {"type": "string"}, "numpy": {"type": "string"}, "platform": {"type": "string"}, "command": {"type": "string"}}
    },
    "artifacts": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "media_type", "bytes"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}}}
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
