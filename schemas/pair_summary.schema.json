{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PuffBear/stochastic-particle-system/schemas/pair_summary.schema.json",
  "title": "Matched null/signal first-interception summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "scenario_seed",
    "policy_id",
    "signal_strength",
    "horizon",
    "null",
    "signal",
    "matched_first_interception_gain",
    "stopped_after_first_interception",
    "zero_signal_identity_checked",
    "input_checksums"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "scenario_seed": {"type": "integer", "minimum": 0},
    "policy_id": {"type": "string", "minLength": 1},
    "signal_strength": {"type": "number", "minimum": 0.0},
    "horizon": {"type": "integer", "minimum": 1},
    "null": {"$ref": "#/$defs/condition_summary"},
    "signal": {"$ref": "#/$defs/condition_summary"},
    "matched_first_interception_gain": {"type": "number"},
    "stopped_after_first_interception": {"type": "boolean"},
    "zero_signal_identity_checked": {"type": "boolean"},
    "input_checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_state_sha256",
        "brownian_sha256",
        "field_nuisance_sha256",
        "policy_randomness_sha256",
        "tie_key_provenance_sha256"
      ],
      "properties": {
        "initial_state_sha256": {"$ref": "#/$defs/sha256"},
        "brownian_sha256": {"$ref": "#/$defs/sha256"},
        "field_nuisance_sha256": {"$ref": "#/$defs/sha256"},
        "policy_randomness_sha256": {"$ref": "#/$defs/sha256"},
        "tie_key_provenance_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "condition_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_interception_step",
        "censored",
        "captured_total",
        "trajectory_steps",
        "tie_decision_count",
        "guarded_reflection_pairs"
      ],
      "properties": {
        "first_interception_step": {"type": "integer", "minimum": 1},
        "censored": {"type": "boolean"},
        "captured_total": {"type": "integer", "minimum": 0},
        "trajectory_steps": {"type": "integer", "minimum": 1},
        "tie_decision_count": {"type": "integer", "minimum": 0},
        "guarded_reflection_pairs": {"type": "integer", "minimum": 0}
      }
    }
  }
}
