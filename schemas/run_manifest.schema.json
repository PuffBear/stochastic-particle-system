{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PuffBear/stochastic-particle-system/schemas/run_manifest.schema.json",
  "title": "Stochastic particle benchmark run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "created_at_utc",
    "repository",
    "environment",
    "pairing",
    "policy",
    "runtime",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "branch", "commit_sha", "dirty"],
      "properties": {
        "full_name": {"const": "PuffBear/stochastic-particle-system"},
        "branch": {"type": "string"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_path", "config_sha256"],
      "properties": {
        "config_path": {"type": "string"},
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pairing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_seed", "conditions", "pre_generated_noise", "shared_initial_state"],
      "properties": {
        "scenario_seed": {"type": "integer", "minimum": 0},
        "conditions": {
          "type": "array",
          "prefixItems": [{"const": "null"}, {"const": "signal"}],
          "items": false
        },
        "pre_generated_noise": {"const": true},
        "shared_initial_state": {"const": true}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "config", "privileged"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "config": {"type": "object"},
        "privileged": {"type": "boolean"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "numpy", "platform", "command"],
      "properties": {
        "python": {"type": "string"},
        "numpy": {"type": "string"},
        "platform": {"type": "string"},
        "command": {"type": "string"}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "media_type", "bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "media_type": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
