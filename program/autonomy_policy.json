{
  "schema_version": 1,
  "no_reply_action": "continue-safe-default",
  "max_user_questions_per_report": 1,
  "allow_reversible_scientific_actions": true,
  "require_user_for": [
    "credentials-or-access",
    "new-spending",
    "licensed-data-approval",
    "major-compute-tranche",
    "out-of-scope-pivot",
    "authorship-or-venue-commitment",
    "submission-or-public-release",
    "destructive-repository-action"
  ],
  "fallback_ladder": [
    "smaller-pilot-or-unit-test",
    "analyze-existing-results",
    "reproduce-or-repair",
    "literature-and-novelty",
    "manuscript-and-supplement",
    "fresh-review",
    "advance-other-paper",
    "validate-expansion-backlogs"
  ]
}
